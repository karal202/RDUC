PORT=3069

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=license_system
# Optional alternative to the individual DB_* values
# DB_URL=mysql://root:password@localhost:3306/license_system

# Generate unique random values for each deployment. Do not commit the real values.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
LICENSE_SECRET_KEY=replace-with-a-long-random-secret

# Desktop app license API
BACKEND_URL=http://localhost:3069/api/license/validate
APP_VERSION_URL=http://localhost:3069/api/app-version
